  /* ===== FOOTER DOCK ===== */
.aurumDock{
  position:fixed;
  left:0; right:0; bottom:0;
  height:60px;
  display:flex;
  justify-content:space-around;
  align-items:center;

  background:
    radial-gradient(circle at top, rgb(21 176 250 / 25%), transparent 60%), linear-gradient(180deg, #020617, #020617f2);
  backdrop-filter:blur(18px);

  border-top:1px solid rgb(21 144 250 / 45%);
  box-shadow:
    0 -18px 45px rgba(0,0,0,.75),
    inset 0 0 30px rgba(255,215,120,.15);

  transform:translateY(120%);
  transition:transform .6s cubic-bezier(.22,.8,.26,1);
  z-index:9999;
}

/* ACTIVE (SCROLL BAWAH) */
.aurumDock.is-visible{
  transform:translateY(0);
}

/* ===== BUTTON ===== */
.aurumBtn{
  width:68px;
  height:68px;
  border-radius:50%;
  background:
    linear-gradient(145deg,#0f172a,#020617);
  border:2px solid #159BFA;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  color:#fff;
  font-size:13px;
  font-weight:700;
  text-decoration:none;

  box-shadow:
    0 0 18px rgb(21 144 250 / 60%), inset 0 0 14px rgba(255, 255, 255, .18);

  transition:.4s cubic-bezier(.4,0,.2,1);
  position:relative;
  overflow:hidden;
}

/* ===== ICON ===== */
.aurumIcon{
  width:34px;
  height:34px;
  margin-bottom:3px;
  background-repeat:no-repeat;
  background-position:center;
  background-size:contain;
  filter:drop-shadow(0 0 8px rgba(255,255,255,.85));
}

/* ICON SOURCE */
.aurumPromo{background-image:url("https://dinkominfo.purbalinggakab.go.id/amp/img/icon.png");}
.aurumLogin{background-image:url("https://dinkominfo.purbalinggakab.go.id/amp/img/icon.png");}
.aurumDaftar{background-image:url("https://dinkominfo.purbalinggakab.go.id/amp/img/icon.png");}
.aurumWA{background-image:url("https://dinkominfo.purbalinggakab.go.id/amp/img/icon.png");}
.aurumChat{background-image:url("https://dinkominfo.purbalinggakab.go.id/amp/img/icon.png");}

/* ===== MAIN BUTTON (TENGAH) ===== */
.aurumBtn.aurumMain{
  width:100px;
  height:100px;
  transform:translateY(-14px);
  background:
    radial-gradient(circle at top, #8ac9fd, #1574fa, #0e5492);

  box-shadow:
    0 0 45px #157CFA, inset 0 0 22px rgba(255, 255, 255, .35);

  animation:aurumPulse 2.6s infinite;
}

.aurumBtn.aurumMain .aurumIcon{
  width:56px;
  height:56px;
}

/* ===== SHINE GLASS ===== */
.aurumBtn::before{
  content:"";
  position:absolute;
  inset:-70%;
  background:linear-gradient(
    120deg,
    transparent,
    rgba(255,255,255,.6),
    transparent
  );
  animation:aurumShine 4.5s linear infinite;
}

/* ===== HOVER ===== */
.aurumBtn:hover{
  transform:translateY(-8px) scale(1.12);
  box-shadow:0 0 40px blue;
}

/* ===== ANIMATION ===== */
@keyframes aurumShine{
  from{transform:translateX(-100%)}
  to{transform:translateX(100%)}
}
@keyframes aurumPulse{
  0%,100%{transform:translateY(-14px) scale(1)}
  50%{transform:translateY(-20px) scale(1.08)}
}

/* ===== MOBILE ===== */
@media(max-width:480px){
  .aurumBtn{width:52px;height:52px}
  .aurumBtn.aurumMain{width:76px;height:76px}
  .aurumBtn.aurumMain .aurumIcon{width:34px;height:34px}
}

</style>

<script>
let lastScroll = 0;
const dock = document.querySelector('.aurumDock');

window.addEventListener('scroll', () => {
  const currentScroll = window.pageYOffset;

  if (currentScroll > lastScroll && currentScroll > 120) {
    dock.classList.add('is-visible');
  } else {
    dock.classList.remove('is-visible');
  }

  lastScroll = currentScroll;
});
</script>





    


