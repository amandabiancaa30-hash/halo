// fungsi shuffle berdasarkan tanggal (biar berubah tiap hari)
function seededShuffle(array, seed) {
  let result = [...array];
  let random = seed;

  for (let i = result.length - 1; i > 0; i--) {
    random = (random * 9301 + 49297) % 233280;
    let j = Math.floor((random / 233280) * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }

  return result;
}

